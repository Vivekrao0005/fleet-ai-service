# Groq LLM — get a key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Server
PORT=3000

# PostgreSQL (direct connection — used when SPRING_DATASOURCE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fleet_ops
PGUSER=your_pg_user
PGPASSWORD=your_pg_password

# PostgreSQL (JDBC-style — used on AWS Elastic Beanstalk)
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-host:5432/fleet_ops
# SPRING_DATASOURCE_USERNAME=your_rds_user
# SPRING_DATASOURCE_PASSWORD=your_rds_password
